# Coolify API Configuration
COOLIFY_URL=https://coolify.example.com
COOLIFY_TOKEN=your-api-token-here

# Server Configuration
NODE_ENV=development
PORT=3000

# Logging Configuration (default: info)
# Options: trace, debug, info, warn, error, fatal
LOG_LEVEL=info

# Log file directory (relative to project root)
LOG_DIR=.logs

# Enable/disable file logging (default: true in dev, false in prod)
LOG_TO_FILES=true

# Timezone for log timestamps (default: Europe/Madrid)
LOG_TIMEZONE=Europe/Madrid

# Safety Mode: Block all destructive operations (POST, PATCH, DELETE, start, stop, restart)
# Options: true, false (default: false)
READ_ONLY=false

# Request timeout in milliseconds (default: 30000)
REQUEST_TIMEOUT=30000

# Maximum retries for transient errors (429, 5xx)
# Default: 3 (1s, 2s, 4s exponential backoff)
MAX_RETRIES=3
