# ============================================================================
# MCP Coolify Server - Plantilla de Configuración
# ============================================================================
# Copia este archivo a .env y completa con tus valores reales
# cp .env.example .env
# ============================================================================

# ============================================================================
# COOLIFY API CONFIGURATION (REQUIRED)
# ============================================================================

# URL base de Coolify con ruta /api/v1
# Ejemplo: https://coolify.midominio.com/api/v1
# IMPORTANTE: Debe terminar exactamente con /api/v1
COOLIFY_BASE_URL=https://coolify.ejemplo.com/api/v1

# Token de autenticación de Coolify API
# Generar en panel Coolify → Settings → API
# IMPORTANTE: Debe empezar con 'tr_'
COOLIFY_TOKEN=tr_tu_token_aqui_xxxxxxxxxxxxx

# ============================================================================
# SERVER CONFIGURATION (OPTIONAL - Defaults shown)
# ============================================================================

# Entorno de ejecución
NODE_ENV=development

# Puerto para servidor MCP
PORT=3000

# ============================================================================
# LOGGING CONFIGURATION (OPTIONAL)
# ============================================================================

# Nivel de logging: trace, debug, info, warn, error, fatal
LOG_LEVEL=info

# Directorio para archivos de log
LOG_DIR=.logs

# Habilitar escritura a archivos .logs/
LOG_TO_FILES=true

# Timezone para timestamps en logs
LOG_TIMEZONE=Europe/Madrid

# ============================================================================
# SAFETY & CONTROL (OPTIONAL)
# ============================================================================

# Modo READ_ONLY - Bloquea operaciones de escritura (POST/PATCH/DELETE)
READ_ONLY=false

# ============================================================================
# REQUEST CONFIGURATION (OPTIONAL)
# ============================================================================

# Timeout para requests a Coolify API (milisegundos)
COOLIFY_REQUEST_TIMEOUT=30000

# Máximo de reintentos para errores transitorios
COOLIFY_MAX_RETRIES=3

# ============================================================================
# BOOTSTRAP VALIDATION (OPTIONAL)
# ============================================================================

# Validar token de Coolify al iniciar
VALIDATE_TOKEN_ON_STARTUP=true

# ============================================================================
# SSH / CONTAINER LOGS (OPTIONAL)
# ============================================================================
# Habilita la tool get_container_logs, que abre SSH contra el host Docker de
# Coolify y ejecuta `docker logs` (cubre servicios y bases de datos, que la
# API REST de Coolify v4 no expone). Operación de solo lectura.
#
# Requisitos cuando SSH_ENABLED=true:
#   - Cliente OpenSSH (`ssh`) disponible en el host donde corre este MCP
#   - La clave pública correspondiente en ~/.ssh/authorized_keys del host Docker
#   - SSH_HOST, SSH_USER y SSH_PRIVATE_KEY_PATH definidos

# Activar/desactivar la funcionalidad (default: false)
SSH_ENABLED=false

# Host o IP del servidor Docker de Coolify
SSH_HOST=coolify.example.com

# Puerto SSH (default: 22)
SSH_PORT=22

# Usuario de login SSH
SSH_USER=deploy

# Ruta absoluta a la clave privada usada para autenticar
# Linux/macOS:  /home/deploy/.ssh/coolify_ed25519
# Windows:      C:\Users\<usuario>\.ssh\coolify_ed25519
SSH_PRIVATE_KEY_PATH=/home/deploy/.ssh/coolify_ed25519

# Política de host key: yes | accept-new | no (default: accept-new)
SSH_STRICT_HOST_KEY_CHECKING=accept-new

# known_hosts alternativo (opcional; default: el del usuario)
# SSH_KNOWN_HOSTS_PATH=

# Timeout por comando remoto en ms (default: 20000; rango 1000-120000)
SSH_COMMAND_TIMEOUT_MS=20000

# ============================================================================
